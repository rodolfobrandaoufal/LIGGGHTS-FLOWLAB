--- a/src/contact_models.h
+++ b/src/contact_models.h
@@ -47,6 +47,44 @@
 #ifndef CONTACT_MODELS_H_
 #define CONTACT_MODELS_H_
 
+/* ----------------------------------------------------------------------
+   LIGGGHTS_FORCE_INLINE marks the per-contact entry points of the normal,
+   tangential, cohesion and rolling sub-models (surfacesIntersect,
+   surfacesClose). GCC otherwise keeps the large ones (e.g. hertz, history)
+   out of line in the huge lammps.cpp TU, which costs a call plus spills of
+   SurfacesIntersectData per contact (roadmap B5, PF-05). Forcing the inline
+   does not change the arithmetic of the models. It is defined here, before
+   any sub-model header is read (every *_model_base.h includes this file).
+   Define LIGGGHTS_NO_FORCE_INLINE to get plain 'inline' back.
+   (LIGGGHTS modernization branch)
+------------------------------------------------------------------------- */
+/* LIGGGHTS_CONTACT_BOUNDARY() is placed between the inlined sub-model calls
+   in ContactModel<Style>::surfacesIntersect. It is an empty asm statement
+   with a "memory" clobber: it emits no instruction, but the compiler must
+   write SurfacesIntersectData / ForceData to memory before it and read them
+   back after it, exactly as it did across the former out-of-line calls.
+   Without it, GCC forwards stored values into the next model and fuses
+   a*b+c into FMA instructions (-ffp-contract=fast is the GCC default)
+   where the out-of-line code rounded the product first, so results change
+   in the last bit and then grow chaotically. With the boundary the inlined
+   kernel is bitwise identical to the out-of-line one (checked for all static
+   combinations by tests/kernel/model_matrix). Define LIGGGHTS_CONTACT_FUSE to
+   drop the boundaries (slightly faster, NOT bitwise identical: FMA-level
+   differences). */
+#if defined(LIGGGHTS_CONTACT_FUSE) || !(defined(__GNUC__) || defined(__clang__))
+#define LIGGGHTS_CONTACT_BOUNDARY() do {} while (0)
+#else
+#define LIGGGHTS_CONTACT_BOUNDARY() __asm__ __volatile__("" ::: "memory")
+#endif
+
+#ifndef LIGGGHTS_FORCE_INLINE
+#if (defined(__GNUC__) || defined(__clang__)) && !defined(LIGGGHTS_NO_FORCE_INLINE)
+#define LIGGGHTS_FORCE_INLINE inline __attribute__((always_inline))
+#else
+#define LIGGGHTS_FORCE_INLINE inline
+#endif
+#endif
+
 #define STATIC_ASSERT(X)
 
 #include "pointers.h"
