diff --git a/src/pair_gran_base.h b/src/pair_gran_base.h
index 3fdad523..3a0ed722 100644
--- a/src/pair_gran_base.h
+++ b/src/pair_gran_base.h
@@ -65,6 +65,17 @@
 
 #include "granular_pair_style.h"
 
+// B5 (PF-05): software-prefetch distance (in neighbours) for the pair loop in
+// Granular<>::compute_force; 0 disables it. Only GCC and Clang provide
+// __builtin_prefetch. (LIGGGHTS modernization branch)
+#ifndef LIGGGHTS_PAIR_PREFETCH
+#if defined(__GNUC__) || defined(__clang__)
+#define LIGGGHTS_PAIR_PREFETCH 1
+#else
+#define LIGGGHTS_PAIR_PREFETCH 0
+#endif
+#endif
+
 namespace LIGGGHTS {
 using namespace ContactModels;
 
@@ -275,6 +286,26 @@ public:
       for (int jj = 0; jj < jnum; jj++) {
         const int j = jlist[jj] & NEIGHMASK;
 
+#if LIGGGHTS_PAIR_PREFETCH > 0
+        // B5 (PF-05): the loop is bound by the latency of the random-access
+        // loads of neighbour j (x[j], radius[j], v[j], omega[j], ...), which
+        // the out-of-order core cannot overlap across the long contact
+        // computation. Prefetch the data of the neighbour LIGGGHTS_PAIR_PREFETCH
+        // positions ahead. Prefetches have no architectural effect: results
+        // are unchanged bit for bit.
+        if (jj + LIGGGHTS_PAIR_PREFETCH < jnum) {
+            const int jp = jlist[jj + LIGGGHTS_PAIR_PREFETCH] & NEIGHMASK;
+            __builtin_prefetch(x[jp], 0, 3);
+            __builtin_prefetch(&radius[jp], 0, 3);
+            __builtin_prefetch(&type[jp], 0, 3);
+            __builtin_prefetch(v[jp], 0, 3);
+            __builtin_prefetch(omega[jp], 0, 3);
+            if (rmass) __builtin_prefetch(&rmass[jp], 0, 3);
+            __builtin_prefetch(f[jp], 1, 3);
+            __builtin_prefetch(torque[jp], 1, 3);
+        }
+#endif
+
         const double xj = x[j][0];
         const double yj = x[j][1];
         const double zj = x[j][2];
