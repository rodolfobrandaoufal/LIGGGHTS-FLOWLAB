# F-VV-5: dump hdf5 with (a) a rank that owns no particles, (b) a group with zero particles globally,
# (c) multifile ('*') naming.  Create ./post_vv before running.
# Run: mpirun -np 2 lmp_hdf5mpi -in in.hdf5_empty_rank ; then python3 audit/scripts/fixes/inspect_h5.py post_vv/*.h5
atom_style    granular
atom_modify   map array
boundary      f f f
newton        off
communicate   single vel yes
processors    2 1 1
units         si
region        reg block -0.05 0.05 -0.02 0.02 -0.02 0.02 units box
create_box    1 reg
neighbor      0.001 bin
neigh_modify  delay 0
fix  m1 all property/global youngsModulus peratomtype 1e7
fix  m2 all property/global poissonsRatio peratomtype 0.3
fix  m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix  m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style gran model hertz tangential history
pair_coeff * *
timestep 1e-6
region left block -0.045 -0.005 -0.015 0.015 -0.015 0.015 units box
lattice sc 0.01
create_atoms 1 region left
set group all diameter 0.002 density 2500
region nowhere block 0.04 0.045 0.0 0.001 0.0 0.001 units box
group nobody region nowhere
fix integr all nve/sphere
dump d0 all hdf5 10 post_vv/single.h5
dump d1 all hdf5 10 post_vv/multi_*.h5
dump d2 nobody hdf5 10 post_vv/empty_group.h5
run 30
