# Task 4c XDMF-growth deck: tiny sparse system, dump every nev steps; thermo cpu gives time per block.
# periodic box, plain fix nve (the only fix using the SoA path). vars: nper (lattice cells per dim), nsteps
atom_style granular
atom_modify map array
boundary p p p
newton off
communicate single vel yes
units si
lattice sc 0.01
variable L equal 0.01*${nper}
region dom block 0 ${L} 0 ${L} 0 ${L} units box
create_box 1 dom
region fill block 0.001 ${L} 0.001 ${L} 0.001 ${L} units box
create_atoms 1 region fill
set group all diameter 0.002 density 2500
velocity all set 0.01 0.02 0.03
neighbor 0.001 bin
neigh_modify delay 0
timestep 1e-5
fix m1 all property/global youngsModulus peratomtype 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style gran model hertz tangential history
pair_coeff * *
fix integr all nve
include ../io/in.dump_${fmt}
thermo_style custom step atoms cpu

thermo ${nthermo}
run ${nsteps}
