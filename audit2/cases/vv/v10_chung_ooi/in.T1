atom_style granular
atom_modify map array
boundary f f f
newton off
communicate single vel yes
units si
hard_particles yes
region dom block -0.05 0.05 -0.05 0.05 -0.05 0.05 units box
create_box 2 dom
neighbor 0.002 bin
neigh_modify delay 0
fix p1 all property/global youngsModulus peratomtype 48000000000.0 48000000000.0
fix p2 all property/global poissonsRatio peratomtype 0.2 0.2
fix p3 all property/global coefficientRestitution peratomtypepair 2 1 1 1 1
fix p4 all property/global coefficientFriction peratomtypepair 2 0 0 0 0
pair_style gran model hertz tangential history
pair_coeff * *
create_atoms 1 single -0.01001 0 0 units box
create_atoms 1 single 0.01001 0 0 units box
set atom * diameter 0.02 density 2800.0
set atom 1 vx 5.0
set atom 2 vx -5.0
timestep 2.3168933193780371e-07
fix integr all nve/sphere
variable d equal 0.02-(x[2]-x[1])
variable fx1 equal fx[1]
thermo_style custom step v_d v_fx1
thermo_modify format float %.17g norm no
thermo 1
run 308
