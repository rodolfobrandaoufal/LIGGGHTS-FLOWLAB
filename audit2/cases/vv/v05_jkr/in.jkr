atom_style granular
atom_modify map array
boundary f f f
newton off
communicate single vel yes
units si
region dom block -0.004 0.004 -0.004 0.004 -0.004 0.004 units box
create_box 1 dom
neighbor 0.0002 bin
neigh_modify delay 0
fix p1 all property/global youngsModulus peratomtype 10000000.0
fix p2 all property/global poissonsRatio peratomtype 0.3
fix p3 all property/global coefficientRestitution peratomtypepair 1 1.0
fix p4 all property/global coefficientFriction peratomtypepair 1 0.5
fix p5 all property/global workOfAdhesion peratomtypepair 1 0.05
pair_style gran model hertz tangential history cohesion jkr
pair_coeff * *
create_atoms 1 single 0 0 0 units box
create_atoms 1 single 0.0020010000000000002 0 0 units box
set atom * diameter 0.002 density 2500.0
group a1 id 1
group a2 id 2
timestep 1e-07
fix f1 a1 move linear 0 0 0
fix f2 a2 move linear -0.001 0 0
variable d equal 0.002-(x[2]-x[1])
variable fx1 equal fx[1]
thermo_style custom step v_d v_fx1
thermo_modify format float %.17g norm no
thermo 20
run 40000
unfix f2
fix f3 a2 move linear 0.001 0 0
run 56696
