atom_style granular
atom_modify map array
boundary f f f
newton off
communicate single vel yes
units si
region dom block -0.01 0.01 -0.004 0.004 -0.004 0.004 units box
create_box 1 dom
neighbor 0.0002 bin
neigh_modify delay 0
fix p1 all property/global youngsModulus peratomtype 1e8
fix p2 all property/global poissonsRatio peratomtype 0.3
fix p3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix p4 all property/global coefficientFriction peratomtypepair 1 0.5
fix p5 all property/global LoadingStiffness peratomtypepair 1 2000.0
fix p6 all property/global UnloadingStiffness peratomtypepair 1 2.0
fix p7 all property/global coefficientAdhesionStiffness peratomtypepair 1 0.0
fix p8 all property/global coefficientPlasticityDepth peratomtypepair 1 0.051166335397324424
fix p9 all property/global pullOffForce peratomtypepair 1 0.0
pair_style gran model luding tangential no_history 
pair_coeff * *
create_atoms 1 single -0.001005 0 0 units box
create_atoms 1 single 0.001005 0 0 units box
set atom * diameter 0.002 density 2500.0
set atom 1 vx 0.5
set atom 2 vx -0.5
timestep 1.1366301927243058e-06
fix integr all nve/sphere
variable vx1 equal vx[1]
variable vx2 equal vx[2]
thermo_style custom step v_vx1 v_vx2
thermo_modify format float %.17g norm no
thermo 10
run 483
