# X-05 bounce test (LIGGGHTS modernization branch, tests/x05).
# Three spheres fall (gravity along -x) onto three frozen spheres and bounce
# several times with sliding, spin and rolling resistance. The bounces are
# far smaller than half the skin, so with the default neighbor settings no
# list is built between a separation and the next touch.
# pair 1 straddles the processor boundary x = 0 (processors 2 1 1).
# variables: nmod (neigh_modify arguments), model, extra (pair_style keywords),
#            newton, px (procs along x), nsteps, cor (restitution),
#            cols (pair/gran/local columns dumped), nt (OpenMP threads, 0 = no package command)
variable nsteps index 10000
variable nt index 0
if "${nt} > 0" then "package omp ${nt} deterministic yes"
variable newton index off
variable px index 1
variable cor index 0.9
variable extra index ""
variable cols index "c_pl[1] c_pl[2] c_pl[3] c_pl[4] c_pl[5] c_pl[6] c_pl[7] c_pl[8] c_pl[9]"
atom_style  granular
atom_modify map array
boundary    f f f
newton      ${newton}
processors  ${px} 1 1
communicate single vel yes
units       si
region      reg block -0.01 0.01 -0.01 0.01 -0.01 0.01 units box
create_box  1 reg
neighbor    0.001 bin
neigh_modify ${nmod}

fix m1 all property/global youngsModulus peratomtype 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 1 ${cor}
fix m4 all property/global coefficientFriction peratomtypepair 1 0.5
fix m5 all property/global coefficientRollingFriction peratomtypepair 1 0.2
fix m6 all property/global characteristicVelocity scalar 0.1
fix m7 all property/global cohesionEnergyDensity peratomtypepair 1 300
# liquid bridges (cohesion easo/capillary/viscous)
fix l1 all property/global surfaceLiquidContentInitial scalar 0.5
fix l2 all property/global liquidSurfaceTension scalar 0.072
fix l3 all property/global fluidViscosity scalar 0.001
fix l4 all property/global contactAngle peratomtype 0.2
fix l5 all property/global minSeparationDistanceRatio scalar 1.01
fix l6 all property/global maxSeparationDistanceRatio scalar 1.1

pair_style  gran model ${model} tangential history ${extra}
pair_coeff  * *
timestep    1e-6

# frozen bases (ids 1,3,5) and bouncing spheres (ids 2,4,6)
create_atoms 1 single -0.0011  0.0     0.0    units box
create_atoms 1 single  0.00092 0.0     0.0    units box
create_atoms 1 single -0.0061  0.006   0.0    units box
create_atoms 1 single -0.00408 0.0062  0.0001 units box
create_atoms 1 single -0.0011 -0.006   0.0    units box
create_atoms 1 single  0.00091 -0.00585 0.0   units box
set atom * diameter 0.002 density 2500
group base id 1 3 5
group ball id 2 4 6
set atom 2 vx -0.05 vy  0.03 vz 0.0
set atom 4 vx -0.04 vy -0.02 vz 0.01
set atom 6 vx -0.03 vy  0.0  vz 0.02
fix fr base freeze
fix gr all gravity 100. vector -1 0 0
fix integr ball nve/sphere

compute pl all pair/gran/local id force history
dump dl all local 1 pairs.txt ${cols}
dump da ball custom 50 atoms.txt id x y z vx vy vz fx fy fz omegax omegay omegaz tqx tqy tqz
dump_modify da sort id
thermo_style custom step atoms ke
thermo 1000
run ${nsteps}
