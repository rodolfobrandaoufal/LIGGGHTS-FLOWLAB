# X-01 regression (tests/meshpbc, LIGGGHTS modernization branch): settling bed on a
# triangulated floor (floor.stl, 8 triangles) in a box periodic in x and y. Derived
# from tests/newton/in.bed (newton off only). leg = 1 sets coplanar_legacy yes,
# leg = -1 omits the keyword (for reference binaries that do not know it).
# 2 atom types, hertz + tangential history + sjkr cohesion + epsd2 rolling (history),
# periodic in x and y (pairs across periodic and rank boundaries), mesh floor by default.
# Atom IDs depend on the rank count with create_atoms, so the test script generates the
# initial state once (np 1, nsteps 0, wr 1) and all runs start from it (rd 1).
# Variables: nw (newton pair flag), nsteps, px py pz (processors), wall (0 primitive floor,
#            1 mesh floor floor.stl), wr (1 = write restart at the end),
#            rd (1 = start from restart file rs.restart), nt (OpenMP threads, 0 = none)
variable nw index off
variable leg index 0
if "${leg} == 1" then "variable legyn string yes" else "variable legyn string no"
variable nsteps index 8000
variable px index *
variable py index *
variable pz index 1
variable wall index 1
variable tdir index .
variable rd index 0
variable wr index 0
variable nt index 0
if "${nt} > 0" then "package omp ${nt}"
atom_style    granular
atom_modify   map array
boundary      p p f
newton        ${nw} off
communicate   single vel yes
units         si
processors    ${px} ${py} ${pz}
if "${rd} == 0" then "region domain block -0.02 0.02 -0.02 0.02 0.0 0.06 units box" "create_box 2 domain" else "read_restart rs.restart"
# read_restart may take the newton pair setting of the file: set it again
newton        ${nw} off
neighbor      0.0008 bin
neigh_modify  delay 0
fix  m1 all property/global youngsModulus peratomtype 5.e6 7.e6
fix  m2 all property/global poissonsRatio peratomtype 0.3 0.35
fix  m3 all property/global coefficientRestitution peratomtypepair 2 0.5 0.6 0.6 0.7
fix  m4 all property/global coefficientFriction peratomtypepair 2 0.5 0.4 0.4 0.3
fix  m5 all property/global cohesionEnergyDensity peratomtypepair 2 3000 3000 3000 3000
fix  m6 all property/global coefficientRollingFriction peratomtypepair 2 0.05 0.05 0.05 0.05
pair_style  gran model hertz tangential history cohesion sjkr rolling_friction epsd2
pair_coeff  * *
if "${wall} == 0" then "fix  w1 all wall/gran model hertz tangential history primitive type 1 zplane 0.0" &
  elif "${leg} < 0" "fix floor all mesh/surface file ${tdir}/floor.stl type 1" "fix  w1 all wall/gran model hertz tangential history mesh n_meshes 1 meshes floor" &
  else "fix floor all mesh/surface file ${tdir}/floor.stl type 1 coplanar_legacy ${legyn}" "fix  w1 all wall/gran model hertz tangential history mesh n_meshes 1 meshes floor"
lattice       sc 0.00402
region        fill block -0.0199 0.0199 -0.0199 0.0199 0.0021 0.03 units box
if "${rd} == 0" then "create_atoms  1 region fill" "set type 1 type/fraction 2 0.5 15485863" "set atom * diameter 0.004 density 2500" "displace_atoms all random 0.00015 0.00015 0.00015 32452843 units box"
fix gravi all gravity 500.0 vector 0.1 0.2 -1.0
fix integr all nve/sphere
timestep 2e-6
compute rke all erotate/sphere
compute pgl all pair/gran/local id force history
thermo_style custom step atoms ke c_rke
thermo_modify format float %.17g
thermo 500
run ${nsteps}
dump d1 all custom 1 atoms.txt id x y z vx vy vz omegax omegay omegaz
dump_modify d1 format "%d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g" sort id
dump d2 all local 1 pairs.txt c_pgl[1] c_pgl[2] c_pgl[3] c_pgl[4] c_pgl[5] c_pgl[6] c_pgl[7] c_pgl[8] c_pgl[9] c_pgl[10] c_pgl[11] c_pgl[12]
dump_modify d2 format "%.0f %.0f %.0f %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
run 0
if "${wr} == 1" then "write_restart bed.restart"
