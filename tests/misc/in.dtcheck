# R2-P02: default time-step warning and atom-drop warning. Simple-cubic
# packing of touching spheres (r 1 mm) on a plane; vars: dt (time-step),
# check (1 = fix check/timestep/gran present).
variable dt    index 0.002
variable check index 0
atom_style    granular
atom_modify   map array
boundary      p p f
newton        off
communicate   single vel yes
units         si
lattice       sc 0.002
region        box block 0 0.032 0 0.032 0 0.024
create_box    1 box
region        fill block 0 0.032 0 0.032 0.001 0.016
create_atoms  1 region fill
set           atom * diameter 0.002 density 2500
neighbor      0.0005 bin
neigh_modify  delay 0
fix m1 all property/global youngsModulus peratomtype 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style gran model hertz tangential history
pair_coeff * *
fix zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix integr all nve/sphere
if "${check} > 0" then "fix ts all check/timestep/gran 100 0.2 0.2 error_fraction none"
timestep ${dt}
thermo 50
run 400
