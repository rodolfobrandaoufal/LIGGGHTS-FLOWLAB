# balance + write_restart + read_restart (cuts are not stored: uniform again)
# then fix balance re-balances in the setup (LIGGGHTS modernization branch, C1)
atom_style     granular
atom_modify    map array
boundary       p p f
newton         off
communicate    single vel yes
units          si
region         dom block 0 0.0416 0 0.0416 0 0.10 units box
create_box     1 dom
neighbor       0.0005 bin
neigh_modify   delay 0
timestep       1e-5
lattice        sc 0.0026
region         fill block 0 0.0416 0 0.0416 0.0013 0.03 units box
create_atoms   1 region fill
set            group all diameter 0.0020
set            group all density 2500
fix m1 all property/global youngsModulus peratomtype 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style     gran model hertz tangential history
pair_coeff     * *
fix zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix integr all nve/sphere
thermo_style   custom step atoms ke
thermo         100
run            200
balance        1.0 shift z 20 1.01
write_restart  out/bal.restart
clear
atom_style     granular
atom_modify    map array
communicate    single vel yes
newton         off
read_restart   out/bal.restart
neighbor       0.0005 bin
neigh_modify   delay 0
fix m1 all property/global youngsModulus peratomtype 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style     gran model hertz tangential history
pair_coeff     * *
fix zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix integr all nve/sphere
fix bal all balance 50 1.05 shift z 20 1.02
thermo_style   custom step atoms ke f_bal f_bal[3]
thermo         100
run            200
