# balance / fix balance regression deck (LIGGGHTS modernization branch, C1)
# settling bidisperse bed, hertz/history, periodic x y, bottom wall
# vars: mode (ref|cmd|cmdbig|fix|fixnever), nsettle, nrun, out
atom_style     granular
atom_modify    map array
boundary       p p f
newton         off
communicate    single vel yes
units          si
variable       mode index ref
variable       nsettle index 8000
variable       nrun index 0
variable       out index out
variable       px index *
variable       py index *
variable       pz index *
processors     ${px} ${py} ${pz}
region         dom block 0 0.0416 0 0.0416 0 0.10 units box
create_box     2 dom
neighbor       0.0005 bin
neigh_modify   delay 0
timestep       1e-5
lattice        sc 0.0026
region         fill block 0 0.0416 0 0.0416 0.0013 0.045 units box
create_atoms   1 region fill
set            type 1 type/fraction 2 0.5 15485863
set            type 1 diameter 0.0020
set            type 2 diameter 0.0024
set            group all density 2500
displace_atoms all random 0.0002 0.0002 0.0002 32452843
fix m1 all property/global youngsModulus peratomtype 5.e6 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 2 0.3 0.3 0.3 0.3
fix m4 all property/global coefficientFriction peratomtypepair 2 0.5 0.5 0.5 0.5
fix m5 all property/global k_finnie peratomtypepair 2 1.0 1.0 1.0 1.0
pair_style     gran model hertz tangential history
pair_coeff     * *
variable       wall index prim
include        in.wall_${wall}
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix integr all nve/sphere
compute        zmean all reduce ave z
compute        cn all contact/atom
compute        ncont all reduce sum c_cn
compute        pgl all pair/gran/local id history
thermo_style   custom step atoms ke c_zmean c_ncont
thermo_modify  norm no format float %20.15g
thermo         500
include        in.mode_${mode}
