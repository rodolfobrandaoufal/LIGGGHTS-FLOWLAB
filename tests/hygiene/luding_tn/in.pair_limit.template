# tan_luding Coulomb limit with a normal model that stores no kc/fo (hooke):
# static overlapping pair (no integrator), constant tangential velocity.
# Expected once sliding: |Ft| = coefficientFriction * FluidViscosity * |Fn|
# (kc = f_adh = 0). LIGGGHTS modernization branch, hygiene agent.
atom_style granular
atom_modify map array
boundary f f f
newton off
communicate single vel yes
units si
region domain block -0.01 0.01 -0.01 0.01 -0.01 0.01 units box
create_box 1 domain
neighbor 0.0002 bin
neigh_modify delay 0
fix m1 all property/global youngsModulus peratomtype 1.e7
fix m2 all property/global poissonsRatio peratomtype 0.3
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.9
fix m4 all property/global coefficientFriction peratomtypepair 1 0.5
fix m5 all property/global characteristicVelocity scalar 1.0
fix m6 all property/global FluidViscosity peratomtypepair 1 0.8
fix m7 all property/global FrictionViscosity peratomtypepair 1 0.2
fix m8 all property/global coeffFrictionStiffness peratomtypepair 1 0.3
pair_style gran model @NORMAL@ tangential tan_luding
pair_coeff * *
timestep 1e-6
create_atoms 1 single -0.000995 0 0 units box
create_atoms 1 single 0.000995 0 0 units box
set atom * diameter 0.002 density 2500.0
velocity all set 0.0 0.0 0.0 units box
group g1 id 1
velocity g1 set 0.0 0.05 0.0 units box
variable fx equal fx[1]
variable fy equal fy[1]
variable fz equal fz[1]
variable st equal step
fix pr all print 1 "${st} ${fx} ${fy} ${fz}" file f.txt screen no
thermo 100000
run 2000
