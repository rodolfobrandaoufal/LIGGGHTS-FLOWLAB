# tangential tan_luding kc/fo guard (LIGGGHTS modernization branch, hygiene agent).
# A small packing that settles on a wall, with many simultaneous contacts per
# particle, run with normal model @NORMAL@ and tangential tan_luding for
# pair gran and wall/gran. The check script fills in @NORMAL@.
#   luding: stores kc/fo in the contact history -> path must be bitwise unchanged
#   hooke : stores no kc/fo -> kc = f_adh = 0 (was contact_history[-1] before)
atom_style granular
atom_modify map array
boundary f f f
newton off
communicate single vel yes
units si
region domain block -0.01 0.01 -0.01 0.01 0.0 0.03 units box
create_box 1 domain
neighbor 0.0004 bin
neigh_modify delay 0
fix m1 all property/global youngsModulus peratomtype 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix m4 all property/global coefficientFriction peratomtypepair 1 0.5
fix m5 all property/global characteristicVelocity scalar 1.0
fix m6 all property/global FluidViscosity peratomtypepair 1 0.8
fix m7 all property/global FrictionViscosity peratomtypepair 1 0.2
fix m8 all property/global coeffFrictionStiffness peratomtypepair 1 0.3
fix m9 all property/global LoadingStiffness peratomtypepair 1 500.0
fix m10 all property/global UnloadingStiffness peratomtypepair 1 5.0
fix m11 all property/global coefficientAdhesionStiffness peratomtypepair 1 0.5
fix m12 all property/global coefficientPlasticityDepth peratomtypepair 1 0.1
fix m13 all property/global pullOffForce peratomtypepair 1 0.0
pair_style gran model @NORMAL@ tangential tan_luding
pair_coeff * *
timestep 1e-5
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix zwall all wall/gran model @NORMAL@ tangential tan_luding primitive type 1 zplane 0.0
fix xw1 all wall/gran model @NORMAL@ tangential tan_luding primitive type 1 xplane -0.01
fix xw2 all wall/gran model @NORMAL@ tangential tan_luding primitive type 1 xplane 0.01
fix yw1 all wall/gran model @NORMAL@ tangential tan_luding primitive type 1 yplane -0.01
fix yw2 all wall/gran model @NORMAL@ tangential tan_luding primitive type 1 yplane 0.01
fix pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2500 radius constant 0.001
fix pdd1 all particledistribution/discrete 32452843 1 pts1 1.0
region bc block -0.009 0.009 -0.009 0.009 0.001 0.029 units box
fix ins all insert/pack seed 32452867 distributiontemplate pdd1 vel constant 0.1 -0.05 -0.5 &
    insert_every once overlapcheck yes all_in yes particles_in_region 300 region bc
fix integr all nve/sphere
thermo_style custom step atoms ke
thermo_modify format float %20.15g
thermo 500
run 4000
dump d all custom 1 final.dump id x y z vx vy vz fx fy fz omegax omegay omegaz
dump_modify d sort id format "%d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
run 0
