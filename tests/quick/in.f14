# F-14 test deck (LIGGGHTS modernization branch, tests/quick).
# fix property/global with a v_ value whose equal-style variable references a
# compute (compute reduce over a per-atom compute). The registry creators in
# Force::init read the property before Modify::init has initialised the
# computes; evaluating the variable there used an uninitialised compute.
# The friction follows the height of the highest particle: c_zmax (compute
# reduce) and bound(all,zmax) (no compute) give the same value, so the two
# runs must be bitwise identical.
# variables: fric (formula of the friction variable), nsteps, out (atom dump), cpl (1: also
#            define compute pair/gran/local with history)
variable nsteps index 600
variable cpl index 0
variable out index atoms_f14.txt
variable fric index "0.3+10.0*c_zmax+0.0*c_kmax"
atom_style  granular
atom_modify map array
boundary    p p f
newton      off
communicate single vel yes
units       si
region      reg block -0.01 0.01 -0.01 0.01 0 0.03 units box
create_box  1 reg
neighbor    0.0004 bin
neigh_modify delay 0

variable mu equal ${fric}
fix m1 all property/global youngsModulus peratomtype 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.7
fix m4 all property/global coefficientFriction peratomtypepair 1 v_mu

pair_style  gran model hertz tangential history
pair_coeff  * *
fix zw all wall/gran model hertz tangential history primitive type 1 zplane 0.0
timestep    1e-5

lattice     sc 0.0022
region      fill block -0.008 0.008 -0.008 0.008 0.001 0.02 units box
create_atoms 1 region fill
set atom * diameter 0.002 density 2500
velocity all set 0 0 -0.5
fix gr all gravity 9.81 vector 0 0 -1
fix integr all nve/sphere

compute ke all ke/atom
compute kmax all reduce max c_ke
compute zmax all reduce max z
if "${cpl} == 1" then "compute pl all pair/gran/local id force history"
thermo_style custom step atoms ke c_kmax v_mu
thermo_modify format float %20.15g
thermo 100
dump da all custom 100 ${out} id x y z vx vy vz fx fy fz omegax omegay omegaz
dump_modify da sort id format "%d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
run ${nsteps}
run 100
