# P0-14 test deck (LIGGGHTS modernization branch, tests/quick).
# Mesh walls with a mesh module (fix mesh/surface/stress, MeshModuleStress):
# one is removed with unfix after the first run, one lives until the end.
# Run under ASan with detect_leaks=1: no leak may come from LIGGGHTS code.
# variables: tdir (directory of floor.stl), nsteps
variable tdir index .
variable nsteps index 600
atom_style    granular
atom_modify   map array
boundary      p p f
newton        off
communicate   single vel yes
units         si
region        domain block -0.02 0.02 -0.02 0.02 -0.01 0.06 units box
create_box    1 domain
neighbor      0.0008 bin
neigh_modify  delay 0
fix  m1 all property/global youngsModulus peratomtype 5.e6
fix  m2 all property/global poissonsRatio peratomtype 0.3
fix  m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix  m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style  gran model hertz tangential history
pair_coeff  * *
fix floor all mesh/surface/stress file ${tdir}/floor.stl type 1 wear finnie
fix low all mesh/surface/stress file ${tdir}/floor.stl type 1 move 0. 0. -0.005
fix m5 all property/global k_finnie peratomtypepair 1 1.0
fix  w1 all wall/gran model hertz tangential history mesh n_meshes 2 meshes floor low
lattice       sc 0.00402
region        fill block -0.0199 0.0199 -0.0199 0.0199 0.0021 0.012 units box
create_atoms  1 region fill
set atom * diameter 0.004 density 2500
velocity all set 0.1 0.2 -2.0
fix gravi all gravity 500.0 vector 0.1 0.2 -1.0
fix integr all nve/sphere
timestep 2e-6
thermo_style custom step atoms ke f_floor[3]
thermo 100
run ${nsteps}
unfix w1
fix  w1 all wall/gran model hertz tangential history mesh n_meshes 1 meshes floor
unfix low
run ${nsteps}
