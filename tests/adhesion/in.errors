# Adhesion agent (phase B2): input errors that must be caught.
# Variables: nm (normal model), prop (1 = define workOfAdhesion, 0 = none)
# (LIGGGHTS modernization branch)
atom_style    granular
atom_modify   map array
boundary      f f f
newton        off
communicate   single vel yes
units         si
region        domain block -0.004 0.004 -0.002 0.002 -0.002 0.002 units box
create_box    1 domain
neighbor      0.0002 bin
timestep      1e-6
fix  m1 all property/global youngsModulus peratomtype 1.e7
fix  m2 all property/global poissonsRatio peratomtype 0.3
fix  m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix  m4 all property/global coefficientFriction peratomtypepair 1 0.5
fix  m8 all property/global kn peratomtypepair 1 1000.
fix  m9 all property/global kt peratomtypepair 1 1000.
fix  m10 all property/global gamman peratomtypepair 1 0.
fix  m11 all property/global gammat peratomtypepair 1 0.
fix  m12 all property/global characteristicVelocity scalar 0.1
if "${prop} == 1" then "fix  m5 all property/global workOfAdhesion peratomtypepair 1 0.05"
if "${prop} == 2" then "fix  m5 all property/global surfaceEnergy peratomtypepair 1 0.05"
pair_style  gran model ${nm} tangential history cohesion ${coh}
pair_coeff  * *
create_atoms  1 single -0.001 0 0 units box
create_atoms  1 single  0.00099 0 0 units box
set atom * diameter 0.002 density 2500
fix integr all nve/sphere
variable f1 equal fx[1]
thermo_style custom step ke v_f1
thermo_modify format float %.17g norm no
run 10
