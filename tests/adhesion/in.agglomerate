# Adhesion agent (phase B2): 2-type cohesive bed settling on an adhesive
# primitive wall with 'model hertz tangential history cohesion ${coh}'.
# workOfAdhesion is given per atom type (mixing w_ij = sqrt(w_i*w_j)).
# Used for the 1 / 2 / 4 rank comparison (run_all.sh).
# Variables (set with -var): coh (jkr|dmt)
# (LIGGGHTS modernization branch)
atom_style    granular
atom_modify   map array
boundary      f f f
newton        off
communicate   single vel yes
units         si
region        domain block -0.006 0.006 -0.006 0.006 0.0 0.024 units box
create_box    2 domain
neighbor      0.0003 bin
neigh_modify  delay 0
timestep      2e-6
fix  m1 all property/global youngsModulus peratomtype 1.e7 2.e7
fix  m2 all property/global poissonsRatio peratomtype 0.3 0.3
fix  m3 all property/global coefficientRestitution peratomtypepair 2 0.5 0.5 0.5 0.5
fix  m4 all property/global coefficientFriction peratomtypepair 2 0.5 0.5 0.5 0.5
fix  m5 all property/global workOfAdhesion peratomtype 0.5 0.2
pair_style  gran model hertz tangential history cohesion ${coh}
pair_coeff  * *
fix zw all wall/gran model hertz tangential history cohesion ${coh} primitive type 1 zplane 0.0
lattice       sc 0.0022
region        fill block -0.005 0.005 -0.005 0.005 0.002 0.02 units box
create_atoms  1 region fill
set group all type/fraction 2 0.5 4711
set type 1 diameter 0.002 density 2500
set type 2 diameter 0.0016 density 2500
velocity all set 0.0 0.0 -0.05
fix grav all gravity 9.81 vector 0.0 0.0 -1.0
fix integr all nve/sphere
compute zmin all reduce min z
compute fmax all reduce max fz
thermo_style custom step atoms ke c_zmin c_fmax
thermo_modify format float %.15g norm no
thermo 2500
run 40000
