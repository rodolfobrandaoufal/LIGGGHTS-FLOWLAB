# Chute wear HPC modernization case
#
# Based on Tutorials_public/chute_wear, with:
# - generalized adhesion contact model
# - time-dependent material properties through fix property/global variables
# - time-dependent radius/density through fix adapt/liggghts
# - particle HDF5/XDMF output
# - mesh HDF5/XDMF output

atom_style    granular
atom_modify   map array
boundary      f f f
newton        off

communicate   single vel yes

units         si

region        domain block -0.5 0.1 -0.2 0.2 -0.4 0.15 units box
create_box    1 domain

neighbor      0.002 bin
neigh_modify  delay 0

timestep      0.00001

# Runtime variables. These are intentionally mild for stability in the example.
variable      tsec equal step*dt
variable      cor equal 0.30+0.05*exp(-v_tsec/0.30)
variable      mu equal 0.35+0.15*exp(-v_tsec/0.20)
variable      adh equal 15.0*exp(-v_tsec/0.25)
variable      rdecay equal 0.0020*exp(-v_tsec*3.00)
variable      rhodecay equal 2500.0*exp(-v_tsec/5.00)

# Material properties. Variable entries are re-evaluated by fix property/global.
fix  m1 all property/global youngsModulus peratomtype 5.e6
fix  m2 all property/global poissonsRatio peratomtype 0.45
fix  m3 all property/global coefficientRestitution peratomtypepair 1 v_cor every 1000
fix  m4 all property/global coefficientFriction peratomtypepair 1 v_mu every 1000
fix  m5 all property/global k_finnie peratomtypepair 1 1.0
fix  m6 all property/global adhesionEnergy peratomtypepair 1 v_adh every 1000

# Shape-agnostic adhesive contact model. The wall uses the same model so mesh
# contacts exercise the generalized adhesion path as well.
pair_style  gran model hertz tangential history cohesion generalized_adhesion
pair_coeff  * *

fix  gravi all gravity 9.81 vector 0.0 0.0 -1.0

# Geometry and wear mesh.
fix  cad all mesh/surface/stress file meshes/simple_chute.stl type 1 wear finnie
fix  inface all mesh/surface file meshes/insertion_face.stl type 1
fix  granwalls all wall/gran model hertz tangential history cohesion generalized_adhesion mesh n_meshes 1 meshes cad

# Particle templates and insertion. Particle radii/density are adapted below,
# so template values only seed newly inserted particles.
fix  pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2500 radius constant 0.0015
fix  pts2 all particletemplate/sphere 15485867 atom_type 1 density constant 2500 radius constant 0.0025
fix  pdd1 all particledistribution/discrete 32452843  2 pts1 0.3 pts2 0.7

group  nve_group region domain
region bc cylinder z 0.0 0.0 0.015 0.05 0.12 units box

fix    ins nve_group insert/stream seed 32452867 distributiontemplate pdd1 &
       nparticles 1200 massrate 0.1 insert_every 1000 overlapcheck yes all_in no vel constant 0.0 0.0 -1.0 &
       insertion_face inface

fix    integr nve_group nve/sphere

# Runtime particle-property adaptation. This path recalculates rmass/inertia and
# triggers neighbor rebuilds if radius growth consumes the skin; here the radius
# decays, so rebuild pressure remains low.
fix    adapt all adapt/liggghts 1000 radius v_rdecay density v_rhodecay

compute       1 all erotate/sphere
thermo_style  custom step atoms ke c_1 vol v_cor v_mu v_adh v_rdecay v_rhodecay
thermo        1000
thermo_modify lost ignore norm no

run    1

dump   particles all hdf5 500 post/chute_hpc_particles.h5
dump   meshout all mesh/hdf5 1000 post/chute_hpc_mesh.h5 cad f sigma_n sigma_t wear

run    100000 upto
unfix  ins
