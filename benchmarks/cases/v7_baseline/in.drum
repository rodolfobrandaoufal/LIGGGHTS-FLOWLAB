# Mesh-dominated benchmark: thin rotating drum (2560 tris), ~10k spheres, hertz/history.
# vars: nsettle, nsteps
atom_style granular
atom_modify map array
boundary f f f
newton off
communicate single vel yes
units si
region dom block -0.065 0.065 -0.002 0.014 -0.065 0.065 units box
create_box 1 dom
neighbor 0.0005 bin
neigh_modify delay 0
timestep 1e-5
fix m1 all property/global youngsModulus peratomtype 5.e6
fix m2 all property/global poissonsRatio peratomtype 0.45
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style gran model hertz tangential history
pair_coeff * *
fix cad all mesh/surface file meshes/drum.stl type 1 curvature 1e-5
fix walls all wall/gran model hertz tangential history mesh n_meshes 1 meshes cad
lattice sc 0.0022
region fill cylinder y 0 0 0.052 0.0012 0.0108 units box
region low block -0.06 0.06 0 0.012 -0.06 0.005 units box
region fl intersect 2 fill low
create_atoms 1 region fl
set group all diameter 0.002 density 2500
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix integr all nve/sphere
fix rot all move/mesh mesh cad rotate origin 0. 0. 0. axis 0. 1. 0. period 3.0
modify_timing on
thermo_style custom step atoms ke
thermo 1000
thermo_modify lost ignore norm no
run ${nsettle}
run ${nsteps}
